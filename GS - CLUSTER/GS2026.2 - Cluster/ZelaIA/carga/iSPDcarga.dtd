<!-- TODO define your own vocabulary/syntax. Example follows:  -->
<!ELEMENT system (trace)>

<!ELEMENT trace (format,(task|file)+)>

<!ELEMENT format EMPTY>
<!ATTLIST format kind CDATA "iSPD" >

<!ELEMENT task (dag|thread)?>
<!ATTLIST task id CDATA "task1">
<!ATTLIST task arr CDATA "0.0">
<!-- The deﬁned states are the same used by SWF and GWF
        0 : job crash
        1 : job successful conclusion
        2 : job preemption
        3 : conclusion of preempted job
        4 : crash of preempted job
        5 : job canceled
-->
<!ATTLIST task sts CDATA "1">
<!ATTLIST task cpsz CDATA "-1">
<!ATTLIST task cmsz CDATA "-1">
<!ATTLIST task usr CDATA "user1">

<!ELEMENT file (receive*,send*)>
<!ATTLIST file id ID #REQUIRED>
<!ATTLIST file size_min CDATA #REQUIRED>
<!ATTLIST file size_max CDATA #REQUIRED>

<!-- dag character: wait | release -->
<!ELEMENT dag (receive*,send*)>

<!ELEMENT thread (process|send|receive|loop|thread)*>

<!ELEMENT loop (process|send|receive|loop|thread)*>
<!ATTLIST loop id ID #REQUIRED>
<!ATTLIST loop iteration CDATA "2">
<!ATTLIST loop start CDATA "0">

<!ELEMENT process EMPTY>
<!ATTLIST process size_min CDATA #REQUIRED>
<!ATTLIST process size_max CDATA #REQUIRED>

<!-- send: task -->
<!ELEMENT send EMPTY>
<!ATTLIST send to CDATA #REQUIRED>
<!ATTLIST send size CDATA #REQUIRED>
<!ATTLIST send port CDATA "80">

<!ELEMENT receive EMPTY>
<!ATTLIST receive id ID #IMPLIED>
<!ATTLIST receive from CDATA "ANY">
<!ATTLIST receive port CDATA "80">